{
	# Bank of Starsector tunables. Every key is optional; missing keys use the built-in defaults.

	"language":"auto",                # auto (system language), en or pt_BR

	# Interest
	"warSurchargeMax":0.25,             # cap on the war surcharge applied to loan rates
	"warSurchargePerWar":0.05,          # +5% per active war between major factions
	"overduePenaltyPerMonth":0.5,       # overdue loans accrue +50% interest per month overdue
	"marketDisruptionModifier":0.10,    # share of disrupted markets that drags investment returns

	# Credit bureau (FICO-style report; see CreditBureau.java)
	"minScoringMonths":6,               # an account must be this old (and reported recently) to be scoreable
	"inquiryDedupeDays":45,             # same-type loan applications inside this window count as one inquiry
	"derogatoryMonths":84,              # late payments, charge-offs and repossessions stay 7 years
	"closedAccountMonths":120,          # closed accounts in good standing stay 10 years
	"bankruptcyRecordMonths":120,       # bankruptcy public record

	# Credit-builder loan (money held at the bank until paid off; builds a credit file)
	"builderMinAmount":10000,
	"builderMaxAmount":50000,
	"builderTermMonths":12,
	"builderRate":0.01,                 # monthly, fixed (no credit or war adjustments)
	"builderMaxScore":500,              # offered to files with no score or a score below this

	# Revolving credit line (draw and repay up to a limit; monthly statement with a minimum payment)
	"lineRate":0.02,                    # monthly base rate, before credit-score and war adjustments
	"lineMinScore":500,
	"lineLimitFair":50000,              # starting limit for a 500-649 score
	"lineLimitGood":200000,             # 650-749
	"lineLimitExcellent":500000,        # 750+
	"lineMinPaymentPct":0.01,           # minimum payment = interest + 1% of the balance...
	"lineMinPaymentFloor":1000,         # ...and at least this much (or the whole balance if smaller)
	"lineIncreaseMonths":6,             # on-time statements between automatic limit increases
	"lineIncreasePct":0.2,
	"lineMaxMultiplier":2,              # increases stop at this multiple of the bracket's starting limit
	"lineLateCutPct":0.25,              # limit cut after a late payment (never below the balance)

	# Colony-secured loan (a colony as collateral; receivership, foreclosure and auction on default)
	"securedLtv":0.6,                   # largest loan: this share of the colony's appraisal
	"securedRateDiscount":0.25,         # rate 25% below the unsecured equivalent
	"securedMinColonySize":4,
	"receivershipStabilityPenalty":3,   # stability lost while a defaulted loan's colony is in receivership
	"foreclosureDelayDays":60,          # days in receivership before the PBC forecloses (Nexerelin only)
	"foreclosureRetryDays":60,          # a new foreclosure invasion if the last one failed
	"foreclosureRelation":-0.65,        # the PBC's relation to the player during a foreclosure (hostile)
	"auctionReservePct":0.7,            # a foreclosed colony never sells under this share of its appraisal
	"appraisalSizeBase":100000,         # appraisal: development value of a size-3 colony...
	"appraisalSizeGrowth":2.5,          # ...times this for each size above 3
	"appraisalResourceTierValue":60000, # per tier of natural resources and traits
	"appraisalIncomeMonths":12,         # months of positive net income counted
	"appraisalImprovedBonus":0.25,      # improved industries count 25% more

	# Fleet insurance (Standard: 60% cover, 10k deductible; Comprehensive: 80%, 5k)
	"insuranceRateStandard":0.008,      # monthly premium rate on the insured value
	"insuranceRateComprehensive":0.013,
	"insuranceWaitingDays":30,          # no claims in a new policy's first days, nor for ships new to the fleet
	"insuranceSettleDays":2,            # claims are settled after post-battle recovery
	"insuranceMonthlyCapPct":0.5,       # payouts per month, share of the insured value
	"insuranceClaimLoad":0.25,          # premium +25% per claim paid in the last 12 months...
	"insuranceMaxClaimsFactor":2,       # ...up to double

	# Collection escalation (days overdue)
	"overduePhase1Days":30,             # past this, banking is restricted (day 1 sends a reminder)
	"overduePhase2Days":60,             # past this, a collection fleet is dispatched
	"overduePhase3Days":90,             # reserved for display
	"defaultThresholdDays":90,          # loan defaults, income garnishment starts
	"collectionFleetCreditsPerFP":10000,
	"collectionFleetMinFP":30,
	"collectionFleetMaxFP":200,
	"collectionFleetEscalation":1.5,    # each defeated collection fleet is replaced by a stronger one
	"collectionFleetRetryDays":30,
	"collectionRefusalRepPenalty":-0.15,
	"shipSurrenderValueFraction":0.6,   # a surrendered ship pays off this fraction of its base value

	# Bankruptcy
	"bankruptcyDebtReduction":0.8,
	"bankruptcyNoLoansMonths":24,
	"bankruptcyNoInvestMonths":12,
	"bankruptcyFullRecoveryMonths":36,
	"bankruptcyRelationPenalty":-0.3,
	"bankruptcyColonyIncomePenalty":0.1,

	# Seizure and withdrawals
	"garnishPercentage":0.3,            # share of colony income taken while a loan is in default
	"earlyWithdrawalPenalty":0.5,       # share of accumulated returns lost on early withdrawal
}
